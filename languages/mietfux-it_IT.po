msgid "Statement not found."
msgstr "Conteggio non trovato."

msgid "No living areas entered for the units – allocation by area is not possible."
msgstr "Nessuna superficie abitabile inserita per le unità – la ripartizione per superficie non è possibile."

msgid "No tenancy in the billing period."
msgstr "Nessuna locazione nel periodo di conteggio."

msgid "“%1$s” (%2$s) not allocated: property has decentralised heating – tenants settle directly with the supplier."
msgstr "«%1$s» (%2$s) non ripartito: l'immobile ha riscaldamento autonomo – gli inquilini regolano direttamente con il fornitore."

msgid "“%1$s”: no (complete) meter readings for the period – allocated by living area instead%2$s."
msgstr "«%1$s»: nessuna lettura del contatore (completa) per il periodo – ripartito invece per superficie abitabile%2$s."

