msgstr "Poprzednie podwyżki"

msgid "Received"
msgstr "Otrzymano"

msgid "Old"
msgstr "Stary"

msgid "New"
msgstr "Nowy"

msgid "Effective from"
msgstr "Obowiązuje od"

