msgstr "Ammortamento (AfA)"

msgid "Loan interest and financing costs"
msgstr "Interessi del mutuo e costi di finanziamento"

msgid "Maintenance expenses"
msgstr "Spese di manutenzione"

msgid "Property tax, street cleaning, refuse collection"
msgstr "Imposta fondiaria, pulizia stradale, raccolta rifiuti"

msgid "Water supply, drainage, communal lighting"
msgstr "Fornitura idrica, fognatura, illuminazione comune"

msgid "Heating, hot water"
msgstr "Riscaldamento, acqua calda"

msgid "Chimney sweeping, building insurance, caretaker, stair cleaning, lift"
msgstr "Spazzacamino, assicurazione dell'edificio, custode, pulizia scale, ascensore"

msgid "Administration costs"
msgstr "Costi di amministrazione"

msgid "Other expenses"
msgstr "Altre spese"

