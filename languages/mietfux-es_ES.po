msgstr "Descripción"

msgid "Receipt file (PDF/photo)"
msgstr "Archivo del justificante (PDF/foto)"

msgid "Meters"
msgstr "Contadores"

msgid "Empty = main meter of the building (info only, not used for allocation)."
msgstr "Vacío = contador general del edificio (solo informativo, no se usa para el reparto)."

msgid "Cold water (m³)"
msgstr "Agua fría (m³)"

msgid "Hot water (m³)"
msgstr "Agua caliente (m³)"

msgid "Heating (kWh / units)"
msgstr "Calefacción (kWh / unidades)"

msgid "Electricity (kWh)"
msgstr "Electricidad (kWh)"

