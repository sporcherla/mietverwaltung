<?xml version="1.0"?>
<ruleset name="Mietverwaltung">
	<description>WordPress Coding Standards für das Plugin Mietverwaltung.</description>
	<file>.</file>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/languages/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>
	<config name="minimum_supported_wp_version" value="6.0"/>
	<config name="testVersion" value="8.0-"/>
	<!-- Eigene Escaping-Helfer (wp_kses mit Whitelist). -->
	<rule ref="WordPress.Security.EscapeOutput">
		<properties>
			<property name="customEscapingFunctions" type="array">
				<element value="mietv_kses_html"/>
				<element value="mietv_kses_svg"/>
			</property>
		</properties>
	</rule>
	<rule ref="WordPress">
		<!-- Deutsche Bezeichner und Dateinamen sind gewollt. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Kurzes Array-Syntax [] ist gewollt. -->
		<exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
		<!-- Yoda-Bedingungen werden nicht erzwungen. -->
		<exclude name="WordPress.PHP.YodaConditions"/>
		<!-- Eigene Tabellen: direkte Datenbankzugriffe und Schema-Änderungen sind Kern des Plugins. -->
		<exclude name="WordPress.DB.DirectDatabaseQuery"/>
		<!-- Kommentardoku wird nicht für jede Methode erzwungen. -->
		<exclude name="Squiz.Commenting"/>
		<exclude name="Generic.Commenting"/>
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<!-- Fehlalarm bei translators-Kommentaren innerhalb von Ausdrücken. -->
		<exclude name="Squiz.PHP.CommentedOutCode"/>
		<!-- Eigenschaften fremder Objekte (DOMDocument, SimpleXML/CAMT) sind camelCase. -->
		<exclude name="WordPress.NamingConventions.ValidVariableName.UsedPropertyNotSnakeCase"/>
	</rule>
	<rule ref="PHPCompatibility"/>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array"><element value="mietfux"/></property>
		</properties>
	</rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array"><element value="mietv"/><element value="Mietv"/><element value="MIETV"/><element value="mietfux"/></property>
		</properties>
	</rule>
</ruleset>
