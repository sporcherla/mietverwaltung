msgstr "Wysłać %s teraz e-mailem?"

msgid "No arrears – all rent accounts balanced."
msgstr "Brak zaległości – wszystkie konta czynszowe wyrównane."

msgid "History"
msgstr "Historia"

msgid "Level"
msgstr "Stopień"

msgid "Deadline"
msgstr "Termin"

