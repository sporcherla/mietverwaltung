msgstr "Número de contador"

msgid "Meter readings"
msgstr "Lecturas del contador"

msgid "Meter reading"
msgstr "Lectura del contador"

msgid "Reading date"
msgstr "Fecha de lectura"

msgid "For the statement: reading at the start and end of the period (e.g. 01.01. and 31.12.)."
msgstr "Para la liquidación: lectura al inicio y al final del periodo (p. ej. 01.01. y 31.12.)."

