msgid "“%1$s” (%2$s) not allocated: property has decentralised heating – tenants settle directly with the supplier."
msgstr "« %1$s » (%2$s) non réparti : le bien a un chauffage individuel – les locataires règlent directement avec le fournisseur."

msgid "“%1$s”: no (complete) meter readings for the period – allocated by living area instead%2$s."
msgstr "« %1$s » : aucun relevé de compteur (complet) pour la période – répartition par surface habitable à la place%2$s."

