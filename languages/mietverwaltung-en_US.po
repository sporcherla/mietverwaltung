msgid "Für Lastschriftmandate; bei der Bundesbank beantragen (kostenlos). Leer = kein SEPA-Mandat."
msgstr "For direct debit mandates; apply at the Bundesbank (free of charge). Empty = no SEPA mandate."

msgid "Erinnerungen"
msgstr "Reminders"

msgid "Tägliche E-Mail bei Hinweisen"
msgstr "Daily email for notices"

msgid "Ein"
msgstr "On"

msgid "Aus"
msgstr "Off"

msgid "Fehlender Mieteingang, Abrechnungsfrist, Zinsbindung, 15-Prozent-Grenze. Nur wenn es etwas zu melden gibt."
msgstr "Missing rent, statement deadline, fixed-rate period, 15 percent limit. Only when there is something to report."

msgid "Empfänger"
msgstr "Recipient"

msgid "Mietrecht"
msgstr "Tenancy law"

msgid "Gebiet mit angespanntem Wohnungsmarkt"
msgstr "Area with a tight housing market"

msgid "Nein (Kappungsgrenze 20 %)"
msgstr "No (cap 20 %)"

msgid "Ja (Kappungsgrenze 15 %)"
msgstr "Yes (cap 15 %)"

msgid "Bayern: Mieterschutzverordnung – gilt u. a. für Fürth, Nürnberg, Erlangen und einige Umlandgemeinden; Zirndorf/Oberasbach/Stein prüfen."
msgstr "Bavaria: Tenant Protection Ordinance – applies e.g. to Fürth, Nuremberg, Erlangen and some surrounding municipalities; check Zirndorf/Oberasbach/Stein."

msgid "Zahlungsfrist Zahlungserinnerung (Tage)"
msgstr "Payment deadline, payment reminder (days)"

msgid "Zahlungsfrist 1. Mahnung (Tage)"
msgstr "Payment deadline, 1st dunning letter (days)"

msgid "Zahlungsfrist letzte Mahnung (Tage)"
msgstr "Payment deadline, final dunning letter (days)"

msgid "Aufbewahrungsfrist nach Mietende (Jahre)"
msgstr "Retention period after end of tenancy (years)"

msgid "10 Jahre für steuerrelevante Unterlagen (§ 147 AO), gerechnet ab Ende des Kalenderjahres."
msgstr "10 years for tax-relevant records (§ 147 AO), counted from the end of the calendar year."

msgid "Deinstallation"
msgstr "Uninstall"

msgid "Beim Löschen des Plugins"
msgstr "When deleting the plugin"

msgid "Alle Daten behalten (Standard)"
msgstr "Keep all data (default)"

msgid "Alle Tabellen und Einstellungen löschen"
msgstr "Delete all tables and settings"

msgid "Gilt nur für „Löschen“ auf der Plugin-Seite, nicht für „Deaktivieren“. Mediathek-Dateien bleiben in jedem Fall."
msgstr "Applies only to “Delete” on the plugins page, not to “Deactivate”. Media library files are always kept."

msgid "Backup"
msgstr "Backup"

msgid "Alle Daten als JSON exportieren"
msgstr "Export all data as JSON"

msgid "Enthält alle Tabellen der Mietverwaltung und die Einstellungen – nicht die Dateien der Mediathek (diese über das normale WordPress-Backup sichern)."
msgstr "Contains all Rental Management tables and settings – not the media library files (back those up with your regular WordPress backup)."

msgid "Wiederherstellen"
msgstr "Restore"

msgid "Ich weiß, dass"
msgstr "I understand that"

msgid "alle vorhandenen Daten ersetzt"
msgstr "all existing data will be replaced"

msgid "werden."
msgstr "."

msgid "Keine Erhöhung möglich: Die ortsübliche Vergleichsmiete bzw. die Kappungsgrenze liegt nicht über der aktuellen Miete."
msgstr "No increase possible: the local reference rent or the cap is not above the current rent."

msgid "Ortsübliche Vergleichsmiete: %1$s €/m² × %2$s m² = %3$s. Kappungsgrenze (%4$d %% auf Miete vor 3 Jahren %5$s): %6$s. Zulässiges Maximum: %7$s."
msgstr "Local reference rent: %1$s €/m² × %2$s m² = %3$s. Cap (%4$d %% on rent 3 years ago %5$s): %6$s. Permitted maximum: %7$s."

msgid "Bitte beide Indexstände (VPI, Basis 2020 = 100) angeben."
msgstr "Please enter both index values (CPI, base 2020 = 100)."

msgid "Indexmiete: Die Miete muss mindestens ein Jahr unverändert gewesen sein (§ 557b Abs. 2 BGB)."
msgstr "Index-linked rent: the rent must have been unchanged for at least one year (§ 557b (2) BGB)."

msgid "VPI %1$s → %2$s = %3$+.2f %%. Neue Kaltmiete %4$s (bisher %5$s). Wirksam ab Beginn des übernächsten Monats nach Zugang: %6$s."
msgstr "CPI %1$s → %2$s = %3$+.2f %%. New base rent %4$s (previously %5$s). Effective from the start of the second month after receipt: %6$s."

msgid "Neue Kaltmiete angeben."
msgstr "Enter new base rent."

msgid "Einvernehmliche Änderung (§ 557 Abs. 1 BGB) bzw. vereinbarte Staffel (§ 557a BGB) – bedarf der Zustimmung des Mieters bzw. der Vereinbarung im Vertrag."
msgstr "Mutual amendment (§ 557 (1) BGB) or agreed stepped rent (§ 557a BGB) – requires the tenant's consent or an agreement in the contract."

msgid "Erhöhung gespeichert und neue Kondition angelegt."
msgstr "Increase saved and new rent condition created."

msgid "PDF öffnen"
msgstr "Open PDF"

msgid "Aktuelle Kaltmiete %1$s, Wohnfläche %2$s m², Mietbeginn %3$s%4$s"
msgstr "Current base rent %1$s, living area %2$s m², start of tenancy %3$s%4$s"

msgid "Ortsübliche Vergleichsmiete (§ 558 BGB)"
msgstr "Local reference rent (§ 558 BGB)"

msgid "Indexmiete (§ 557b BGB)"
msgstr "Index-linked rent (§ 557b BGB)"

msgid "Vereinbarung / Staffel"
msgstr "Agreement / stepped rent"

msgid "Zugang des Schreibens beim Mieter"
msgstr "Receipt of the letter by the tenant"

msgid "Ortsübliche Vergleichsmiete (€/m²)"
msgstr "Local reference rent (€/m²)"

msgid "Mietspiegel (Fürth/Nürnberg qualifiziert), drei Vergleichswohnungen oder Gutachten"
msgstr "Rent index (qualified for Fürth/Nuremberg), three comparable flats or expert opinion"

msgid "Gewünschte neue Kaltmiete (€)"
msgstr "Desired new base rent (€)"

msgid "leer = zulässiges Maximum"
msgstr "empty = permitted maximum"

msgid "Begründung"
msgstr "Justification"

msgid "z. B. „Mietspiegel der Stadt Fürth 2025, Feld C3: 8,90–10,40 €/m², Mittelwert 9,60 €/m²“"
msgstr "e.g. “Fürth rent index 2025, field C3: €8.90–10.40/m², mean €9.60/m²”"

msgid "VPI bei letzter Mietfestsetzung"
msgstr "CPI at last rent setting"

msgid "Verbraucherpreisindex Deutschland, Basis 2020 = 100 (destatis)"
msgstr "Consumer price index Germany, base 2020 = 100 (Destatis)"

msgid "VPI aktuell"
msgstr "Current CPI"

msgid "Neue Kaltmiete (€)"
msgstr "New base rent (€)"

msgid "Prüfen"
msgstr "Check"

msgid "Bisher"
msgstr "Previously"

msgid "Neu ab %s"
msgstr "New from %s"

msgid "Erhöhung"
msgstr "Increase"

msgid "Erhöhung speichern, Kondition anlegen, Schreiben erzeugen"
msgstr "Save increase, create rent condition, generate letter"

msgid "Bisherige Erhöhungen"
msgstr "Previous increases"

msgid "Zugang"
msgstr "Receipt"

msgid "Alt"
msgstr "Old"

msgid "Neu"
msgstr "New"

msgid "Wirksam ab"
msgstr "Effective from"

msgid "Schreiben"
msgstr "Letter"

msgid "die Nettokaltmiete für die von Ihnen gemietete Wohnung beträgt derzeit"
msgstr "the net base rent for the flat you rent is currently"

msgid "monatlich. Hiermit verlange ich Ihre Zustimmung zur Erhöhung der Nettokaltmiete auf"
msgstr "per month. I hereby request your consent to an increase of the net base rent to"

msgid "monatlich mit Wirkung"
msgstr "per month with effect"

msgid "ab dem %s"
msgstr "from %s"

msgid "Begründung:"
msgstr "Justification:"

msgid "Die Miete ist seit mindestens 15 Monaten unverändert; die Kappungsgrenze (§ 558 Abs. 3 BGB) ist eingehalten. Die Vorauszahlungen bleiben unverändert, sodass die monatliche Gesamtmiete ab dem %s"
msgstr "The rent has been unchanged for at least 15 months; the cap (§ 558 (3) BGB) is observed. The advance payments remain unchanged, so the total monthly rent from %s"

msgid "beträgt."
msgstr "will be."

msgid "Bitte erteilen Sie Ihre Zustimmung bis zum Ablauf des zweiten Kalendermonats nach Zugang dieses Schreibens (§ 558b Abs. 2 BGB), indem Sie die beiliegende Kopie unterschrieben zurücksenden oder den erhöhten Betrag ab dem %s überweisen."
msgstr "Please give your consent by the end of the second calendar month after receipt of this letter (§ 558b (2) BGB) by returning the enclosed copy signed or by transferring the increased amount from %s."

msgid "Zustimmungserklärung"
msgstr "Declaration of consent"

msgid "gemäß der im Mietvertrag vereinbarten Indexmiete passe ich die Nettokaltmiete entsprechend der Entwicklung des Verbraucherpreisindex für Deutschland an. %s."
msgstr "in accordance with the index-linked rent agreed in the tenancy agreement, I am adjusting the net base rent in line with the consumer price index for Germany. %s."

msgid "Die Nettokaltmiete erhöht sich von"
msgstr "The net base rent increases from"

msgid "auf"
msgstr "to"

msgid "monatlich"
msgstr "per month"

msgid ". Die Gesamtmiete einschließlich Vorauszahlungen beträgt dann %s."
msgstr ". The total rent including advance payments will then be %s."

msgid "Einer Zustimmung bedarf es nicht; die Anpassung wird mit Beginn des übernächsten Monats nach Zugang dieses Schreibens wirksam (§ 557b Abs. 3 BGB). Bitte passen Sie Ihren Dauerauftrag entsprechend an."
msgstr "No consent is required; the adjustment takes effect at the start of the second month after receipt of this letter (§ 557b (3) BGB). Please adjust your standing order accordingly."

msgid "wie besprochen bzw. vertraglich vereinbart beträgt die Nettokaltmiete"
msgstr "as discussed or contractually agreed, the net base rent is"

msgid "monatlich (bisher %1$s). Grund: %2$s. Die Gesamtmiete einschließlich Vorauszahlungen beträgt dann %3$s."
msgstr "per month (previously %1$s). Reason: %2$s. The total rent including advance payments will then be %3$s."

msgid "Bitte passen Sie Ihren Dauerauftrag entsprechend an."
msgstr "Please adjust your standing order accordingly."

msgid "Vermieterdaten, Bankverbindung, Gläubiger-ID, Steuernummer und Absender für Schreiben eintragen."
msgstr "Enter landlord details, bank account, creditor ID, tax number and sender for letters."

msgid "Objekt & Einheiten"
msgstr "Property & units"

msgid "Haus/Eigentumswohnung als Objekt anlegen (Baujahr, Heizungsart), darunter die Einheiten (Wohnung, Garage, Stellplatz) mit Fläche und Personen."
msgstr "Create the house/condominium as a property (year built, heating type), then the units beneath it (flat, garage, parking space) with area and persons."

msgid "Mieter erfassen – optional mit Ehe-/Lebenspartner als zweite Vertragspartei. Beide erscheinen automatisch in Vertrag, Schreiben und SEPA-Mandat."
msgstr "Enter tenants – optionally with spouse/partner as second contracting party. Both appear automatically in the agreement, letters and SEPA mandate."

msgid "Mietverhältnis & Konditionen"
msgstr "Tenancy & rent conditions"

msgid "Mietverhältnis = Mieter + Einheit + Beginn. Garage/Stellplatz als Zusatzeinheit anhängen, dann gibt es eine Gesamtmiete. Konditionen (Kaltmiete, Vorauszahlungen) mit Gültig-ab-Datum anlegen."
msgstr "Tenancy = tenant + unit + start date. Attach garage/parking as an additional unit to get one total rent. Create rent conditions (base rent, advance payments) with a valid-from date."

msgid "Anlagegut & Darlehen"
msgstr "Asset & loan"

msgid "Kaufpreis, Nebenkosten (Notar, Grundbuch, Grunderwerbsteuer, Makler) und Grundanteil erfassen – der Kaufvertrag als PDF kann direkt ausgelesen werden. Darlehen mit Zins, Tilgung und Rate anlegen."
msgstr "Enter purchase price, incidental costs (notary, land registry, transfer tax, agent) and land share – the purchase contract PDF can be parsed directly. Create loans with interest, repayment and instalment."

msgid "Laufender Betrieb"
msgstr "Day-to-day"

msgid "Mieteingänge in der Übersicht abhaken oder per Bankimport einlesen, Belege fotografieren, Zählerstände erfassen. Am Jahresende: Betriebskostenabrechnung und Anlage V."
msgstr "Tick rent payments in the overview or import them from the bank, photograph receipts, record meter readings. At year end: service charge statement and Anlage V."

msgid "Zeigt offene Posten, fällige Aufgaben und Kennzahlen. Offene Mieten lassen sich per Häkchen als bezahlt buchen – die Zahlung wird zum 1. des Monats eingetragen."
msgstr "Shows open items, due tasks and key figures. Open rents can be booked as paid by ticking – the payment is recorded on the 1st of the month."

msgid "Mit „Fokusmodus“ wird das übrige WordPress-Menü ausgeblendet; die Einstellung gilt pro Benutzer."
msgstr "“Focus mode” hides the rest of the WordPress menu; the setting is per user."

msgid "Jede Zahlung gehört zu einem Mietverhältnis und einem Monat. Quelle: manuell, Bankimport oder abgehakt. Soll/Ist ergibt sich aus den Konditionen."
msgstr "Each payment belongs to a tenancy and a month. Source: manual, bank import or ticked. Due/paid is derived from the rent conditions."

msgid "Rechnungen mit Kostenart, Steuerjahr und Datei erfassen (am Handy direkt per Kamera). Die Kostenart entscheidet über Umlagefähigkeit (BetrKV) und die Zeile in Anlage V."
msgstr "Record invoices with cost type, tax year and file (directly via camera on your phone). The cost type determines recoverability (BetrKV) and the line in Anlage V."

msgid "Erhaltungsaufwand kann nach § 82b EStDV auf 2–5 Jahre verteilt werden; Handwerkerlohn (§ 35a) wird gesondert ausgewiesen."
msgstr "Maintenance expenses can be spread over 2–5 years under § 82b EStDV; tradesmen's labour (§ 35a) is shown separately."

msgid "CSV- oder CAMT.053-Export der Bank einlesen. Regeln ordnen Buchungen anhand von IBAN oder Verwendungszweck automatisch einem Mietverhältnis oder einer Kostenart zu; Duplikate werden erkannt."
msgstr "Import the bank's CSV or CAMT.053 export. Rules automatically assign transactions to a tenancy or cost type by IBAN or reference; duplicates are detected."

msgid "Schadens- und Mängelmeldungen der Mieter aus dem Mieterportal mit Status und Verlauf."
msgstr "Damage and defect reports from tenants via the tenant portal, with status and history."

msgid "Ablage für Verträge, Protokolle, Schreiben und Abrechnungen. Mit „für Mieter sichtbar“ erscheint das Dokument im Mieterportal."
msgstr "Storage for agreements, protocols, letters and statements. With “visible to tenant” the document appears in the tenant portal."

msgid "Ein Objekt ist ein Haus oder eine Eigentumswohnung. Baujahr bestimmt den gesetzlichen AfA-Satz; Heizungsart und Verbrauchsanteil steuern die Heizkostenverteilung (HeizkostenV 50–70 %)."
msgstr "A property is a house or a condominium. Year built determines the statutory depreciation rate; heating type and consumption share control heating cost allocation (HeizkostenV 50–70 %)."

msgid "Wohnung, Garage oder Stellplatz innerhalb eines Objekts. Fläche und Personen werden für Umlageschlüssel verwendet."
msgstr "Flat, garage or parking space within a property. Area and persons are used for allocation keys."

msgid "Stammdaten des Mieters. Ehe-/Lebenspartner optional als Mitmieter – dann haften beide gesamtschuldnerisch und werden überall automatisch genannt. Ein verknüpfter WordPress-Benutzer erhält Zugang zum Mieterportal."
msgstr "Tenant master data. Spouse/partner optionally as co-tenant – both are then jointly and severally liable and named automatically everywhere. A linked WordPress user gets access to the tenant portal."

msgid "Verbindet Mieter und Einheit mit Beginn, Ende und Kaution. Zusatzeinheiten (Garage, Stellplatz) mit eigenem Mietanteil ergeben eine Gesamtmiete und eine Buchung."
msgstr "Links tenant and unit with start, end and deposit. Additional units (garage, parking) with their own rent share result in one total rent and one booking."

msgid "Kaltmiete und Vorauszahlungen (Betriebs-/Heizkosten) mit Gültig-ab-Datum. Bei Änderung neue Kondition anlegen, nicht die alte überschreiben – so bleibt die Historie erhalten."
msgstr "Base rent and advance payments (service/heating) with a valid-from date. For changes create a new condition rather than overwriting the old one – this preserves the history."

msgid "Erzeugt einen vollständigen Wohnraummietvertrag (20 §§) aus den Stammdaten, dazu Hausordnung, Merkblatt, Datenschutzinformation, SEPA-Mandat und Übergabeprotokoll – als PDF oder Druckansicht, auf Wunsch direkt in den Dokumenten abgelegt."
msgstr "Generates a complete residential tenancy agreement (20 sections) from the master data, plus house rules, information sheet, privacy notice, SEPA mandate and handover protocol – as PDF or print view, optionally filed directly under Documents."

msgid "Die Optionen (Befristung, Staffel/Index, Kleinreparaturen, Tiere, Schönheitsreparaturen …) werden je Mietverhältnis gespeichert."
msgstr "The options (fixed term, stepped/index rent, minor repairs, pets, decorative repairs …) are saved per tenancy."

msgid "Kautionskonto nach § 551 BGB: Einzahlungen (bis 3 Raten), taggenaue Verzinsung, Abrechnung bei Auszug."
msgstr "Deposit account under § 551 BGB: payments (up to 3 instalments), daily interest, settlement on move-out."

msgid "Erhöhung nach § 558 BGB (Vergleichsmiete, Kappungsgrenze 15/20 %, Sperrfrist) oder § 557b (Index). Erzeugt das Schreiben und legt nach Zustimmung die neue Kondition an."
msgstr "Increase under § 558 BGB (reference rent, cap 15/20 %, waiting period) or § 557b (index). Generates the letter and creates the new rent condition after consent."

msgid "Drei Mahnstufen mit Fristen und Texten. Schreiben als PDF, optional per E-Mail an Mieter und Mitmieter."
msgstr "Three dunning levels with deadlines and texts. Letters as PDF, optionally by email to tenant and co-tenant."

msgid "Strom-, Gas-, Wasser- und Wärmezähler je Einheit oder Objekt (Allgemeinstrom)."
msgstr "Electricity, gas, water and heat meters per unit or property (communal electricity)."

msgid "Ablesungen mit Datum. Mieter können Stände selbst im Portal melden (Quelle „Mieter“)."
msgstr "Readings with date. Tenants can submit readings themselves in the portal (source “Tenant”)."

msgid "Jahresabrechnung nach BetrKV: Belege des Jahres werden nach Schlüssel (Fläche, Personen, Einheiten, Verbrauch) verteilt, zeitanteilig bei Mieterwechsel; Leerstand trägt der Vermieter. Vorauszahlungen werden gegengerechnet, § 35a-Anteile ausgewiesen."
msgstr "Annual statement under BetrKV: the year's receipts are allocated by key (area, persons, units, consumption), pro rata on tenant change; vacancy is borne by the landlord. Advance payments are offset, § 35a shares are shown."

msgid "Fertige Abrechnung als Schreiben (PDF) erzeugen, in Dokumenten ablegen und im Portal freigeben. Vorauszahlung kann direkt angepasst werden."
msgstr "Generate the finished statement as a letter (PDF), file it under Documents and release it in the portal. The advance payment can be adjusted directly."

msgid "Katalog nach BetrKV § 2 (vorbelegt) plus eigene Arten. Je Kostenart: umlagefähig ja/nein, Umlageschlüssel, Zeile in Anlage V."
msgstr "Catalogue per BetrKV § 2 (pre-filled) plus your own types. Per cost type: recoverable yes/no, allocation key, line in Anlage V."

msgid "Anlagegüter (AfA)"
msgstr "Assets (depreciation)"

msgid "Gebäude mit Anschaffungskosten, einzelnen Nebenkosten (Grunderwerbsteuer, Notar, Grundbuch, Makler, Sonstiges) und Grundanteil. AfA linear nach § 7 Abs. 4 EStG (2 %, 2,5 % vor 1925, 3 % ab 2023) oder degressiv, zeitanteilig im ersten Jahr."
msgstr "Building with acquisition costs, itemised incidental costs (transfer tax, notary, land registry, agent, other) and land share. Depreciation straight-line under § 7 (4) EStG (2 %, 2.5 % before 1925, 3 % from 2023) or declining balance, pro rata in the first year."

msgid "Der Kaufvertrag kann als PDF hochgeladen werden; Kaufpreis, Datum und Nebenkosten werden daraus vorgeschlagen. Der 15-%-Wächter warnt vor anschaffungsnahem Herstellungsaufwand (§ 6 Abs. 1 Nr. 1a EStG)."
msgstr "The purchase contract can be uploaded as PDF; purchase price, date and incidental costs are suggested from it. The 15 % guard warns of acquisition-related construction costs (§ 6 (1) no. 1a EStG)."

msgid "Finanzierungsdarlehen mit Zinssatz, Tilgung, Rate und Zinsbindung. Daraus entsteht der Tilgungsplan."
msgstr "Financing loans with interest rate, repayment, instalment and fixed-rate period. The repayment schedule is derived from these."

msgid "Tilgungsplan mit Raten zum Abhaken, Sondertilgungen und Restschuld. Abgehakte Raten liefern die Jahreszinsen für Anlage V, sofern keine Zinsbescheinigung eingetragen ist."
msgstr "Repayment schedule with instalments to tick off, extra repayments and outstanding balance. Ticked instalments provide the annual interest for Anlage V unless an interest certificate is entered."

msgid "Jahreswerte laut Bankbescheinigung (Zinsen, Tilgung, Restschuld). Haben Vorrang vor den berechneten Werten."
msgstr "Annual figures per bank certificate (interest, repayment, balance). Take precedence over calculated values."

msgid "Jahresauswertung je Objekt: Einnahmen, Werbungskosten nach Zeilen der Anlage V, AfA, Schuldzinsen, Vorjahresvergleich. Export als CSV; Zeilenzuordnung anpassbar."
msgstr "Annual report per property: income, expenses by Anlage V line, depreciation, loan interest, prior-year comparison. CSV export; line mapping adjustable."

msgid "Zuordnungsregeln für den Bankimport: Suchbegriff oder IBAN → Mietverhältnis oder Kostenart."
msgstr "Matching rules for the bank import: search term or IBAN → tenancy or cost type."

msgid "Beendete Mietverhältnisse nach Ablauf der Aufbewahrungsfristen anonymisieren, Auskunft nach Art. 15 DSGVO exportieren. Löschkonzept und Fristen im Überblick."
msgstr "Anonymise ended tenancies after the retention periods expire, export access reports under Art. 15 GDPR. Overview of deletion concept and deadlines."

msgid "Legt in fünf Schritten Vermieter, Objekt, Einheiten (Wohnung + Garage), Mieter und Mietverhältnis mit Konditionen an. Jeder Schritt speichert sofort; der Assistent kann jederzeit erneut aufgerufen werden, um die Angaben zu ergänzen."
msgstr "Creates landlord, property, units (flat + garage), tenant and tenancy with rent conditions in five steps. Each step saves immediately; the wizard can be reopened at any time to complete the entries."

msgid "Vermieterdaten, Bankverbindung, Gläubiger-ID, Steuernummer, Mahn- und Portaloptionen. Backup aller Plugin-Tabellen als JSON, Wiederherstellung, Option „Daten bei Deinstallation löschen“."
msgstr "Landlord details, bank account, creditor ID, tax number, dunning and portal options. Backup of all plugin tables as JSON, restore, option “delete data on uninstall”."

msgid "Mieterportal"
msgstr "Tenant portal"

msgid "Shortcode [mietverwaltung_portal] auf einer Seite einfügen. Angemeldete Mieter (verknüpfter WordPress-Benutzer) sehen Abrechnungen und freigegebene Dokumente, melden Schäden und Zählerstände."
msgstr "Insert the shortcode [mietverwaltung_portal] on a page. Logged-in tenants (linked WordPress user) see statements and released documents, and report damage and meter readings."

msgid "Mietverwaltung für private Vermieter: Stammdaten, Zahlungen, Belege, Betriebskostenabrechnung, Steuer (Anlage V), Mietvertrag und Mieterportal in einem Plugin. Auf jeder Seite finden Sie oben rechts unter „Hilfe“ eine Kurzbeschreibung."
msgstr "Rental management for private landlords: master data, payments, receipts, service charge statements, tax (Anlage V), tenancy agreement and tenant portal in one plugin. On every page you will find a short description under “Help” at the top right."

msgid "Schnellstart"
msgstr "Quick start"

msgid "Einrichtungsassistent starten"
msgstr "Start setup wizard"

msgid "– führt durch die Schritte 1 bis 4 und legt das erste Mietverhältnis an."
msgstr "– guides through steps 1 to 4 and creates the first tenancy."

msgid "Module"
msgstr "Modules"

msgid "Rechtliche Hinweise"
msgstr "Legal notes"

msgid "Das Plugin ersetzt keine Rechts- oder Steuerberatung. Vertragsmuster, Berechnungen und Fristen beruhen auf der Rechtslage in Deutschland (BGB, BetrKV, HeizkostenV, EStG) und sind vor Verwendung zu prüfen. Alle Daten bleiben in Ihrer WordPress-Datenbank; es werden keine Daten an Dritte übertragen."
msgstr "The plugin does not replace legal or tax advice. Contract templates, calculations and deadlines are based on German law (BGB, BetrKV, HeizkostenV, EStG) and must be checked before use. All data stays in your WordPress database; no data is transmitted to third parties."

msgid "Version"
msgstr "Version"

msgid "Alle Hilfethemen"
msgstr "All help topics"

msgid "Keine Konditionen für "
msgstr "No rent conditions for "

msgid "Miete %1$s fehlt oder unvollständig: %2$s (Soll %3$s, Ist %4$s)"
msgstr "Rent %1$s missing or incomplete: %2$s (due %3$s, paid %4$s)"

msgid "Rückstand %1$s bei %2$s"
msgstr "Arrears %1$s for %2$s"

msgid "Betriebskostenabrechnung %1$d für %2$s noch nicht fertiggestellt – Frist 31.12.%3$d (§ 556 Abs. 3 BGB), noch %4$d Tage"
msgstr "Service charge statement %1$d for %2$s not yet finalised – deadline 31 Dec %3$d (§ 556 (3) BGB), %4$d days left"

msgid "Zinsbindung %1$s endet am %2$s (%3$d Tage) – Anschlussfinanzierung prüfen"
msgstr "Fixed-rate period %1$s ends on %2$s (%3$d days) – check follow-up financing"

msgid "Zinsbescheinigung %1$d für Darlehen %2$s noch nicht erfasst"
msgstr "Interest certificate %1$d for loan %2$s not yet entered"

msgid "Anschaffungsnahe Herstellungskosten überschritten bei %1$s (%2$s netto > %3$s)"
msgstr "Acquisition-related construction cost limit exceeded for %1$s (%2$s net > %3$s)"

