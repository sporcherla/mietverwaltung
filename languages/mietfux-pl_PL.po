msgid "Statement not found."
msgstr "Nie znaleziono rozliczenia."

msgid "No living areas entered for the units – allocation by area is not possible."
msgstr "Brak wpisanych powierzchni mieszkalnych lokali – rozliczenie według powierzchni nie jest możliwe."

msgid "No tenancy in the billing period."
msgstr "Brak najmu w okresie rozliczeniowym."

msgid "“%1$s” (%2$s) not allocated: property has decentralised heating – tenants settle directly with the supplier."
msgstr "„%1$s” (%2$s) nie rozliczono: nieruchomość ma ogrzewanie zdecentralizowane – najemcy rozliczają się bezpośrednio z dostawcą."

msgid "“%1$s”: no (complete) meter readings for the period – allocated by living area instead%2$s."
msgstr "„%1$s”: brak (kompletnych) odczytów liczników za okres – rozliczono zamiast tego według powierzchni mieszkalnej%2$s."

msgid "Heating meters are read by a reading service: enter the heating/hot-water share from the service’s statement for %s (below the overview)."
msgstr "Liczniki ogrzewania odczytuje firma rozliczeniowa: wpisz udział ogrzewania/ciepłej wody z jej rozliczenia dla %s (pod przeglądem)."

msgid "Check: heating receipts in the period total %1$s, the reading-service shares entered total %2$s."
msgstr "Kontrola: rachunki za ogrzewanie w okresie wynoszą %1$s, wpisane udziały z firmy rozliczeniowej %2$s."

msgid "Permission denied."
msgstr "Brak uprawnień."

